# Copy to .env.local and fill in. Everything here is optional:
# anything left blank keeps its clearly marked placeholder or setup state.
# These values are public (they end up in the built site), so URLs only, no secrets.

# Where "Sign In" goes: your existing 3 Wins app.
VITE_SIGN_IN_URL=

# Where "Get Started" and "Start Winning" go. Defaults to the pricing section.
VITE_GET_STARTED_URL=

# Your Stripe Checkout or Payment Link URL. Enables the "Get 3 Wins" button.
VITE_STRIPE_CHECKOUT_URL=

# Footer links. Left blank, they show as "Soon" rather than linking anywhere.
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_CONTACT_URL=
